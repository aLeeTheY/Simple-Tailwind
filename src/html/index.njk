        <section id="SketchBook">
            <div
                class="wrapper py-60 flex flex-col laptop:flex-row-reverse laptop:gap-x-30 laptop:pb-0 laptop:pr-0 laptop:overflow-hidden desktop:py-90 desktop:pb-0 desktop:pr-165">
                <div
                    class="w-full max-w-450 tablet:self-center laptop:flex-370 laptop:max-h-330 laptop:max-w-730 desktop:max-h-410 desktop:min-w-730">
                    <img
                        class="w-full h-full object-cover object-top-left laptop:min-h-342"
                        src="./assets/images/sketchbook.png"
                        alt="SketchBook" />
                </div>
                <div class="flex flex-col gap-y-30 justify-between laptop:pb-60 laptop:flex-330 desktop:pb-90 desktop:justify-center">
                    <div class="flex flex-col gap-y-20 tablet:pt-10 laptop:pt-0">
                        <h2
                            class="section-header text-2xl/none text-[#666666] tracking-normal font-[Roboto] laptop:text-3xl/none desktop:text-[40px]">
                            Simple скетчбук
                        </h2>
                        <p class="text-base/[170%] text-[#85859B] tracking-normal font-[Roboto] laptop:text-lg/[170%]">
                            80 листов, твердая обложка, бумага Fabriano 200 г/м2. Подойдет и для графики и для акварели. Для самых смелых
                            творческих замыслов!
                        </p>
                    </div>
