{% extends "base/base.njk" %}

<!-- ? название текущей страницы в домене --->
{% set current_page__page_name = 'index' %}

<!-- ? передаем текстовые данные из файла переовдов *.json для 'head' этой страницы -->
{% set current_page__head_content = index.head %}

{% block content %}
    <div id="Page-Content">
        <section id="Hero" class="wrapper tablet:flex tablet:gap-x-30">
            <div class="flex flex-col py-49 gap-y-21 tablet:py-60 laptop:gap-y-30 laptop:py-65 justify-between desktop:justify-center">
                <div class="hero-main-text flex flex-col gap-y-15 tablet:gap-y-20 laptop:gap-y-30">
                    <h1
                        class="text-[#4C5866] text-3xl/none tracking-normal font-[Roboto] max-w-220 tablet:text-[38px] tablet:max-w-290 laptop:text-[50px] laptop:max-w-390 desktop:text-[60px] desktop:max-w-450">
                        Простые вещи. Из бумаги
                    </h1>
                    <p class="text-[#85859B] text-sm/[150%] tablet:text-base/[150%] tracking-normal font-[Roboto] laptop:text-lg">
                        Бума́га (предположительно от итал. bombagia, первоисточником же считается иранский) — волокнистый материал
                        с минеральными добавками.
                    </p>
                </div>
                <a
                    href="#!"
                    class="block max-w-min px-38 tablet:px-60 py-14.5 tablet:py-18.5 border border-[#7875FE] text-[#7875FE] text-lg tablet:text-xl font-[Roboto] tracking-normal leading-none laptop:py-23.5 laptop:px-89.5">
                    Каталог
                </a>
            </div>
            <!-- <img
                    class="hidden tablet:block bg-amber-50 max-h-416 pt-20 object-contain object-bottom"
                    src="./assets/images/hero.png"
                    alt="Hero main image"
                /> -->
            <div
                class="hidden tablet:block min-w-195 max-h-416 overflow-hidden pt-20 laptop:pt-60 laptop:min-w-270 laptop:max-h-470 desktop:min-w-540 desktop:max-h-620">
                <img class="h-full w-full object-cover object-top" src="./assets/images/hero.png" alt="Hero main image" />
            </div>
        </section>
        <section id="Study-Result" class="bg-[#ebebeb]">
            <div
                class="wrapper py-60 flex flex-col justify-between items-stretch tablet:items-start laptop:grid laptop:grid-rows-[auto_1fr] laptop:grid-cols-[auto_1fr] laptop:grid-flow-dense laptop:gap-y-40 laptop:gap-x-30 desktop:gap-y-90 desktop:py-90 desktop:items-center">
                <div
                    class="instruction w-full flex flex-col tablet:flex-row gap-y-20 tablet:gap-x-30 tablet:justify-between laptop:col-span-2 font-[Roboto] text-base/[150%] tracking-normal laptop:text-lg/normal">
                    <div
                        class="w-full flex tablet:flex-col gap-x-30 tablet:gap-y-20 justify-center tablet:items-center laptop:items-start border-t border-t-[#C0C0C0] pt-20 desktop:flex-row desktop:items-center">
                        <img
                            class="w-[max(40vw,130px)] tablet:w-[clamp(150px,26vw,160px)]"
                            src="./assets/images/paper_v1.png"
                            alt="Paper V1" />
                        <div class="flex flex-col items-start justify-center">
                            <h3 class="text-[#666666] font-medium">V.1</h3>
                            <p class="text-[#85859B]">Результат вашего обучения</p>
                        </div>
                    </div>
                    <div
                        class="w-full flex tablet:flex-col gap-x-30 tablet:gap-y-20 justify-center tablet:items-center laptop:items-start border-t border-t-[#C0C0C0] pt-20 desktop:flex-row desktop:items-center">
                        <img
                            class="w-[max(40vw,130px)] tablet:w-[clamp(150px,26vw,160px)]"
                            src="./assets/images/paper_v2.png"
                            alt="Paper V2" />
                        <div class="flex flex-col items-start justify-center">
                            <h3 class="text-[#666666]font-medium">V.2</h3>
                            <p class="text-[#85859B]">Результат вашего обучения</p>
                        </div>
                    </div>
                    <div
                        class="w-full flex tablet:flex-col gap-x-30 tablet:gap-y-20 justify-center tablet:items-center laptop:items-start border-t border-t-[#C0C0C0] pt-20 desktop:flex-row desktop:items-center">
                        <img
                            class="w-[max(40vw,130px)] tablet:w-[clamp(150px,26vw,160px)]"
                            src="./assets/images/paper_v3.png"
                            alt="Paper V3" />
                        <div class="flex flex-col items-start justify-center">
                            <h3 class="text-[#666666] font-medium">V.3</h3>
                            <p class="text-[#85859B]">Результат вашего обучения</p>
                        </div>
                    </div>
                </div>
                <img
                    class="block pt-60 pb-20 tablet:pt-40 tablet:max-w-330 laptop:py-0 desktop:max-w-730"
                    src="./assets/images/paper_big.png"
                    alt="Paper Big" />
                <div class="content flex flex-col gap-y-14 laptop:gap-y-20">
                    <h2
                        class="section-header text-2xl/none text-[#666666] tracking-normal font-[Roboto] laptop:text-3xl/none desktop:text-[40px]">
                        Максимальная белизна
                    </h2>
                    <p class="text-base/[170%] text-[#85859B] tracking-normal font-[Roboto] laptop:text-lg/[170%]">
                        Для повышения белизны, гладкости и мягкости в состав бумажной массы вводят белые минеральные вещества: мел, тальк,
                        каолин и др. Эта операция называется наполнением.
                    </p>
                    <p class="text-base/[170%] text-[#85859B] tracking-normal font-[Roboto] laptop:text-lg/[170%]">
                        Отлив бумажного листа осуществляют на бумагоделательной машине, важнейшей частью которой является непрерывно
                        движущаяся (как транспортер) металлическая или капроновая сетка.
                    </p>
                </div>
            </div>
        </section>
        <section id="Advanced">
            <div
                class="wrapper grid grid-cols-1 tablet:grid-cols-2 gap-y-60 tablet:max-laptop:gap-y-40 tablet:gap-x-30 desktop:grid-cols-4 py-60 desktop:py-90">
                <div class="card grid grid-rows-[auto_1fr_auto]">
                    <img
                        class="w-full object-cover object-top aspect-290/180 tablet:aspect-240/180 laptop:aspect-330/180 desktop:aspect-255/180"
                        src="./assets/images/sec3_img1.png"
                        alt="Advanced section. Img #1" />
                    <div class="flex flex-col gap-y-8 pt-20 pb-30 tablet:pb-20">
                        <div class="flex flex-col gap-y-4 laptop:gap-y-8">
                            <h3 class="text-[#666666] text-2xl tracking-normal font-[Roboto] laptop:text-3xl">Упаковка</h3>
                            <h4 class="text-[#B5B5BD] text-sm tracking-normal font-[Roboto]">Тираж: от 50 штук</h4>
                        </div>
                        <p class="text-[#85859B] text-base/[170%] tracking-normal font-[Roboto] laptop:text-lg/[170%]">
                            Сделано из крафт-бумаги или плотного картона. Упаковки имеют различные формы и расцветки, изготовим форму под
                            заказ.
                        </p>
                    </div>
                    <a href="#!" class="flex items-center gap-x-5 text-[#7875FE] text-xl font-[Roboto] tracking-normal">
                        <span>Подробнее</span>
                        <img src="./assets/images/icons/arrow.svg" alt="Arrow right" />
                    </a>
                </div>
                <div class="card grid grid-rows-[auto_1fr_auto]">
                    <img
                        class="w-full object-cover object-top aspect-290/180 tablet:aspect-240/180 laptop:aspect-330/180 desktop:aspect-255/180"
                        src="./assets/images/sec3_img2.png"
                        alt="Advanced section. Img #2" />
                    <div class="flex flex-col gap-y-8 pt-20 pb-30 tablet:pb-20">
                        <div class="flex flex-col gap-y-4 laptop:gap-y-8">
                            <h3 class="text-[#666666] text-2xl tracking-normal font-[Roboto] laptop:text-3xl">Пакеты</h3>
                            <h4 class="text-[#B5B5BD] text-sm tracking-normal font-[Roboto]">Тираж: от 200 штук</h4>
                        </div>
                        <p class="text-[#85859B] text-base/[170%] tracking-normal font-[Roboto] laptop:text-lg/[170%]">
                            С прямоугольным дном. От 10 см до 60 см по высоте. Материалы: картон, крафт-бумага. Различные расцветки
                            и дизайн.
                        </p>
                    </div>
                    <a href="#!" class="flex items-center gap-x-5 text-[#7875FE] text-xl font-[Roboto] tracking-normal">
                        <span>Подробнее</span>
                        <img src="./assets/images/icons/arrow.svg" alt="Arrow right" />
                    </a>
                </div>
                <div class="card grid grid-rows-[auto_1fr_auto]">
                    <img
                        class="w-full object-cover object-top aspect-290/180 tablet:object-top-left tablet:aspect-240/180 laptop:aspect-330/180 desktop:aspect-255/180"
                        src="./assets/images/sec3_img3.png"
                        alt="Advanced section. Img #3" />
                    <div class="flex flex-col gap-y-8 pt-20 pb-30 tablet:pb-20">
                        <div class="flex flex-col gap-y-4 laptop:gap-y-8">
                            <h3 class="text-[#666666] text-2xl tracking-normal font-[Roboto] laptop:text-3xl">Кейсы</h3>
                            <h4 class="text-[#B5B5BD] text-sm tracking-normal font-[Roboto]">Тираж: от 30 штук</h4>
                        </div>
                        <p class="text-[#85859B] text-base/[170%] tracking-normal font-[Roboto] laptop:text-lg/[170%]">
                            Подойдет для документов и других бумаг. Различные расцветки, размеры и плотность. Материал: прессованная бумага.
                        </p>
                    </div>
                    <a href="#!" class="flex items-center gap-x-5 text-[#7875FE] text-xl font-[Roboto] tracking-normal">
                        <span>Подробнее</span>
                        <img src="./assets/images/icons/arrow.svg" alt="Arrow right" />
                    </a>
                </div>
                <div class="card grid grid-rows-[auto_1fr_auto]">
                    <img
                        class="w-full object-cover object-top aspect-290/180 tablet:aspect-240/180 laptop:aspect-330/180 desktop:aspect-255/180"
                        src="./assets/images/sec3_img4.png"
                        alt="Advanced section. Img #4" />
                    <div class="flex flex-col gap-y-8 pt-20 pb-30 tablet:pb-20">
                        <div class="flex flex-col gap-y-4 laptop:gap-y-8">
                            <h3 class="text-[#666666] text-2xl tracking-normal font-[Roboto] laptop:text-3xl">Другие изделия</h3>
                            <h4 class="text-[#B5B5BD] text-sm tracking-normal font-[Roboto]">Тираж: от 100 штук</h4>
                        </div>
                        <p class="text-[#85859B] text-base/[170%] tracking-normal font-[Roboto] laptop:text-lg/[170%]">
                            Нестандартные упаковки, кейсы и другие изделия различных размеров и конфигураций. Изготовим в кратчайшие сроки.
                        </p>
                    </div>
                    <a href="#!" class="flex items-center gap-x-5 text-[#7875FE] text-xl font-[Roboto] tracking-normal">
                        <span>Подробнее</span>
                        <img src="./assets/images/icons/arrow.svg" alt="Arrow right" />
                    </a>
                </div>
            </div>
        </section>
        <section id="Partners" class="bg-[#ebebeb]">
            <div class="wrapper py-60 desktop:py-90">
                <div
                    class="hidden tablet:grid tablet:grid-cols-[repeat(2,minmax(240px,1fr))] tablet:grid-rows-[repeat(2,127px)] tablet:gap-30 laptop:grid-cols-[repeat(4,minmax(150px,1fr))] laptop:grid-rows-[80px] desktop:grid-cols-[repeat(4,minmax(255px,1fr))] desktop:laptop:grid-rows-[135px]">
                    <a href="#!" class="flex justify-center items-center border border-[#C4C4C4]">
                        <img
                            src="./assets/images/icons/hahnemuehle.svg"
                            alt="Hahnemuehle logo"
                            class="w-[min(132px,76.67%)] tablet:max-laptop:w-[min(211px,76.67%)] desktop:w-[min(225px,76.67%)]" />
                    </a>
                    <a href="#!" class="flex justify-center items-center border border-[#C4C4C4]">
                        <img
                            src="./assets/images/icons/canson.svg"
                            alt="Canson logo"
                            class="w-[min(132px,76.67%)] tablet:max-laptop:w-[min(211px,76.67%)] desktop:w-[min(225px,76.67%)]" />
                    </a>
                    <a href="#!" class="flex justify-center items-center border border-[#C4C4C4]">
                        <img
                            src="./assets/images/icons/royal_talens.svg"
                            alt="Royal Talents logo"
                            class="w-[min(132px,76.67%)] tablet:max-laptop:w-[min(211px,76.67%)] desktop:w-[min(225px,76.67%)]" />
                    </a>
                    <a href="#!" class="flex justify-center items-center border border-[#C4C4C4]">
                        <img
                            src="./assets/images/icons/fabriano.svg"
                            alt="Fabriano logo"
                            class="w-[min(132px,76.67%)] tablet:max-laptop:w-[min(211px,76.67%)] desktop:w-[min(225px,76.67%)]" />
                    </a>
                </div>

