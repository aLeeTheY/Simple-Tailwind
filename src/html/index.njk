{% extends "base/base.njk" %}

<!-- ? название текущей страницы в домене --->
{% set current_page__page_name = 'index' %}

<!-- ? передаем текстовые данные из файла переовдов *.json для 'head' этой страницы -->
{% set current_page__head_content = index.head %}

{% block content %}
    <section id="hero" class="wrapper flex justify-between my-hero__gap-x" data-beasties-container>
        <div class="flex flex-col justify-center my-hero__left-part__gap-y my-hero__left-part__py my-hero__left-part__min-w">
            <div class="flex flex-col my-hero__h1-group__gap-y my-hero__h1-group__max-w">
                <h1 class="max-w-[clamp(220px,0.2588*100vw+136.9176px,286px)] tablet:max-w-none">Простые вещи. Из бумаги</h1>
                <p class="paragraph paragraph--hero">
                    Бума́га (предположительно от итал. bombagia, первоисточником же считается иранский) — волокнистый материал с минеральными
                    добавками.
                </p>
            </div>
            <a href="#!" class="link-as-button">Каталог</a>
        </div>

        <div class="hero-img">
            <img src="@images/hero.png" alt="Картинка раздела Hero" fetchpriority="high" decoding="auto" />
        </div>
    </section>

    <section id="paper-showcase" class="bg-[#ebebeb]" data-beasties-container>
        <div class="wrapper my-paper-showcase__main-container">
            <div class="flex flex-col gap-y-20 tablet:flex-row tablet:justify-between tablet:gap-x-30 laptop:col-span-2">
                <div class="paper-variant-container">
                    <img class="paper-variant-container__img" src="@images/papers/paper_v1.png" alt="Вариант бумаги №1" />

                    <div class="grid-in-[variant-text] min-w-0 flex flex-col">
                        <h4>V.1</h4>
                        <p class="paragraph paragraph--paper-variant">Результат вашего обучения</p>
                    </div>
                </div>

                <div class="paper-variant-container">
                    <img class="paper-variant-container__img" src="@images/papers/paper_v2.png" alt="Вариант бумаги №2" />

                    <div class="grid-in-[variant-text] min-w-0 flex flex-col">
                        <h4>V.2</h4>
                        <p class="paragraph paragraph--paper-variant">Результат вашего обучения</p>
                    </div>
                </div>

                <div class="paper-variant-container">
                    <img class="paper-variant-container__img" src="@images/papers/paper_v3.png" alt="Вариант бумаги №3" />

                    <div class="grid-in-[variant-text] min-w-0 flex flex-col">
                        <h4>V.3</h4>
                        <p class="paragraph paragraph--paper-variant">Результат вашего обучения</p>
                    </div>
                </div>
            </div>

            <img
                class="pt-60 pb-20 tablet:pt-40 tablet:max-w-330 laptop:self-start laptop:py-0 laptop:min-w-[clamp(330px,0.5976*100vw-129.5663px,730px)]"
                src="@images/papers/paper_big.png"
                alt="Бошьшой вариант бумаги" />

            <div class="flex flex-col gap-y-14 laptop:self-center laptop:gap-y-20">
                <h2>Максимальная белизна</h2>

                <div class="flex flex-col gap-y-10">
                    <p class="paragraph">
                        Для повышения белизны, гладкости и мягкости в состав бумажной массы вводят белые минеральные вещества: мел, тальк,
                        каолин и др. Эта операция называется наполнением.
                    </p>

                    <p class="paragraph">
                        Отлив бумажного листа осуществляют на бумагоделательной машине, важнейшей частью которой является непрерывно
                        движущаяся (как транспортер) металлическая или капроновая сетка.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section id="assortment">
        <div
            class="wrapper py-[clamp(60px,0.0447*100vw+25.6185px,90px)] grid grid-cols-1 gap-y-[clamp(40px,-0.0784*100vw+85.1765px,60px)] tablet:grid-cols-2 tablet:gap-x-30 tablet:gap-y-[clamp(40px,0.1047*100vw-20.4188px,60px)] desktop:grid-cols-4">
            <div class="flex flex-col justify-between gap-y-20">
                <div class="flex flex-col">
                    <img class="object-cover object-top min-h-180" src="@images/assortment/sec3_img1.png" alt="Товар: Упаковка" />

                    <div class="flex flex-col gap-y-8 pt-20">
                        <div class="flex flex-col gap-y-[clamp(4px,0.0209*100vw-8.0838px,8px)]">
                            <h3>Упаковка</h3>
                            <h5>Тираж: от 50 штук</h5>
                        </div>

                        <p class="paragraph">
                            Сделано из крафт-бумаги или плотного картона. Упаковки имеют различные формы и расцветки, изготовим форму под
                            заказ.
                        </p>
                    </div>
                </div>

                <a class="product-link" href="#!">
                    <span>Подробнее</span>
                    <div>
                        <svg width="9" height="15" aria-hidden="true">
                            <use href="@icons/other/arrow.svg"></use>
                        </svg>
                    </div>
                </a>
            </div>

            <div class="flex flex-col justify-between gap-y-20">
                <div class="flex flex-col">
                    <img class="object-cover object-top min-h-180" src="@images/assortment/sec3_img2.png" alt="Товар: Пакеты" />

                    <div class="flex flex-col gap-y-8 pt-20">
                        <div class="flex flex-col gap-y-[clamp(4px,0.0209*100vw-8.0838px,8px)]">
                            <h3>Пакеты</h3>
                            <h5>Тираж: от 200 штук</h5>
                        </div>

                        <p class="paragraph">
                            С прямоугольным дном. От 10 см до 60 см по высоте. Материалы: картон, крафт-бумага. Различные расцветки и
                            дизайн.
                        </p>
                    </div>
                </div>

                <a class="product-link" href="#!">
                    <span>Подробнее</span>
                    <div>
                        <svg width="9" height="15" aria-hidden="true">
                            <use href="@icons/other/arrow.svg"></use>
                        </svg>
                    </div>
                </a>
            </div>

            <div class="flex flex-col justify-between gap-y-20">
                <div class="flex flex-col">
                    <img class="object-cover object-top min-h-180" src="@images/assortment/sec3_img3.png" alt="Товар: Кейсы" />

                    <div class="flex flex-col gap-y-8 pt-20">
                        <div class="flex flex-col gap-y-[clamp(4px,0.0209*100vw-8.0838px,8px)]">
                            <h3>Кейсы</h3>
                            <h5>Тираж: от 30 штук</h5>
                        </div>

                        <p class="paragraph">
                            Подойдет для документов и других бумаг. Различные расцветки, размеры и плотность. Материал: прессованная бумага.
                        </p>
                    </div>
                </div>

                <a class="product-link" href="#!">
                    <span>Подробнее</span>
                    <div>
                        <svg width="9" height="15" aria-hidden="true">
                            <use href="@icons/other/arrow.svg"></use>
                        </svg>
                    </div>
                </a>
            </div>

            <div class="flex flex-col justify-between gap-y-20">
                <div class="flex flex-col">
                    <img class="object-cover object-top min-h-180" src="@images/assortment/sec3_img4.png" alt="Товар: Другие изделия" />

                    <div class="flex flex-col gap-y-8 pt-20">
                        <div class="flex flex-col gap-y-[clamp(4px,0.0209*100vw-8.0838px,8px)]">
                            <h3>Другие изделия</h3>
                            <h5>Тираж: от 100 штук</h5>
                        </div>

                        <p class="paragraph">
                            Нестандартные упаковки, кейсы и другие изделия различных размеров и конфигураций. Изготовим в кратчайшие сроки.
                        </p>
                    </div>
                </div>

                <a class="product-link" href="#!">
                    <span>Подробнее</span>
                    <div>
                        <svg width="9" height="15" aria-hidden="true">
                            <use href="@icons/other/arrow.svg"></use>
                        </svg>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <section id="partners" class="bg-[#ebebeb]">
        <div class="negative-wrapper tablet:wrapper py-[clamp(60px,0.0447*100vw+25.6185px,90px)]">
            <div class="my-partners__cards__grid">
                <a class="company-card grid-in-[hahnemuehle]" href="https://www.hahnemuehle.com/">
                    <svg width="197" height="55" aria-hidden="true">
                        <use href="@icons/companies/hahnemuehle.svg"></use>
                        <span class="sr-only">Перейти на сайт Hahnemuehle</span>
                    </svg>
                </a>
                <a class="company-card grid-in-[canson]" href="https://canson.com/">
                    <svg width="186" height="53" aria-hidden="true">
                        <use href="@icons/companies/canson.svg"></use>
                        <span class="sr-only">Перейти на сайт Canson</span>
                    </svg>
                </a>
                <a class="company-card grid-in-[royal-talens]" href="https://www.royaltalens.com/">
                    <svg width="225" height="21" aria-hidden="true">
                        <use href="@icons/companies/royal_talens.svg"></use>
                        <span class="sr-only">Перейти на сайт Royal Talens</span>
                    </svg>
                </a>
                <a class="company-card grid-in-[fabriano]" href="https://fabriano.com/">
                    <svg width="209" height="26" aria-hidden="true">
                        <use href="@icons/companies/fabriano.svg"></use>
                        <span class="sr-only">Перейти на сайт Fabriano</span>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <section id="sketchbook">
        <div
            class="wrapper flex flex-col laptop:flex-row-reverse laptop:gap-x-30 my-sketchbook__main-container__gap-y my-sketchbook__main-container__pr">
            <div class="w-full laptop:max-h-410 my-sketchbook__img-container__mt">
                <img class="w-full h-full object-cover object-top-left" src="@images/sketchbook.png" alt="Simple скетчбук" />
            </div>
            <div class="pb-60 flex flex-col gap-y-30 laptop:justify-center my-sketchbook__text-part__max-w my-sketchbook__text-part__py">
                <div class="flex flex-col gap-y-20">
                    <h2>Simple скетчбук</h2>
                    <p class="paragraph">
                        80 листов, твердая обложка, бумага Fabriano 200 г/м2. Подойдет идля графики и для акварели. Для самых смелых
                        творческих замыслов!
                    </p>
                </div>
                <a href="#!" class="link-as-button">Купить</a>
            </div>
        </div>
    </section>
{% endblock %}
